# Cerebras API Key for live deep-research graph and streaming chat
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gemma-4-31b

# Mistral API Key for alternate batch inference
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512

# Tavily API Key (optional) — enables the highest tier of the retrieval ladder
TAVILY_API_KEY=

# Optional Redis Connection URL (defaults to in-memory cache if not provided)
REDIS_URL=

# Backend Service Base URL
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Edge Media Proxy Base URL (defaults to Next.js /api/media edge proxy if not provided)
NEXT_PUBLIC_CF_PROXY_URL=