# Cerebras API Key for live ultra-fast node expansions and streaming chat
CEREBRAS_API_KEY=

# Mistral API Key for batch precomputations and embedding similarity calculations
MISTRAL_API_KEY=

# Optional Redis Connection URL (defaults to in-memory cache if not provided)
REDIS_URL=

# Backend Service Base URL
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Edge Media Proxy Base URL (defaults to Next.js /api/media edge proxy if not provided)
NEXT_PUBLIC_CF_PROXY_URL=
